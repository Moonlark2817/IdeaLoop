# Server Config
PORT=5000
NODE_ENV=development

# Database Config (PostgreSQL / Render / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/idealoop_db

# JWT signing secret (required for the API; at least 32 random characters)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional AWS S3 storage foundation (disabled until configured)
S3_ENABLED=false
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_READ_URL_TTL_SECONDS=900

# Prefer an AWS profile locally or an IAM role in production.
# Static/temporary environment credentials are optional; never commit real values.
# AWS_PROFILE=idealoop-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
